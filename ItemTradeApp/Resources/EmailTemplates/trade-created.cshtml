@model ItemTradeApp.Resources.EmailTemplates.Models.TradeCreatedEmailModel
@{
    Layout = "Layouts/MainLayout.cshtml";
    ViewBag.Title = "Trade utworzony";
    ViewBag.Header = "Trade został utworzony";
    ViewBag.Subtitle = "Twoja wymiana została pomyślnie rozpoczęta i oczekuje na dalszą obsługę.";
}

<tr>
<td style="padding:20px 24px;">
<div style="font-size:13px;color:#475569;margin-bottom:8px;">Trade został utworzony na podstawie oferty:</div>
<div style="font-size:14px;font-weight:600;">@Model.OfferName</div>
</td>
</tr>

<tr>
<td style="padding:0 24px;">
<hr style="border:none;border-top:1px solid #e2e8f0;">
</td>
</tr>

<tr>
<td style="padding:20px 24px;font-size:14px;">
<table width="100%" cellpadding="6" cellspacing="0" style="font-size:14px;">
<tr>
<td style="color:#64748b;width:40%;">Kupujący</td>
<td style="font-weight:500;">@Model.BuyerNickname</td>
</tr>
<tr>
<td style="color:#64748b;">Sprzedający</td>
<td style="font-weight:500;">@Model.SellerNickname</td>
</tr>
<tr>
<td style="color:#64748b;">Data utworzenia</td>
<td>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
</tr>
</table>
</td>
</tr>

<tr>
<td style="padding:0 24px;">
<hr style="border:none;border-top:1px solid #e2e8f0;">
</td>
</tr>

<tr>
<td style="padding:20px 24px;">
<div style="font-size:14px;font-weight:600;margin-bottom:10px;">Co dalej?</div>

<p style="margin:0 0 10px 0;font-size:13px;line-height:1.6;color:#475569;">
Teraz nasz pracownik, który zajmie się Państwa wymianą, skontaktuje się z Państwem na platformie indywidualnie w utworzonym chacie.
</p>

<p style="margin:0 0 10px 0;font-size:13px;line-height:1.6;color:#475569;">
W chacie otrzymają Państwo dalsze instrukcje dotyczące przebiegu wymiany, przekazania przedmiotów oraz potwierdzenia kolejnych etapów transakcji.
</p>

<p style="margin:0;font-size:13px;line-height:1.6;color:#475569;">
Prosimy nie przekazywać itemów poza ustalonym procesem oraz regularnie sprawdzać wiadomości na platformie, aby trade mógł zostać sprawnie zakończony.
</p>
</td>
</tr>

<tr>
<td style="padding:0 24px;">
<hr style="border:none;border-top:1px solid #e2e8f0;">
</td>
</tr>

<tr>
<td style="padding:20px 24px;font-size:14px;">
<div style="font-weight:600;margin-bottom:8px;">Podsumowanie</div>

<table width="100%" cellpadding="6" cellspacing="0" style="font-size:14px;">
<tr>
<td style="color:#64748b;width:40%;">Koszt tokenów</td>
<td style="font-weight:500;">@Model.TokensCost</td>
</tr>
<tr>
<td style="color:#64748b;">Status</td>
<td style="font-weight:500;">Oczekuje na kontakt pracownika</td>
</tr>
</table>
</td>
</tr>