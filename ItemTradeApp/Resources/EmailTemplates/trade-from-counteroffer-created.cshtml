@model ItemTradeApp.Resources.EmailTemplates.Models.TradeFromCounterOfferCreatedEmailModel
@{
    Layout = "Layouts/MainLayout.cshtml";
    ViewBag.Title = "Trade z kontroferty";
    ViewBag.Header = "Trade z kontroferty został utworzony";
    ViewBag.Subtitle = "Wymiana została rozpoczęta na podstawie zaakceptowanej kontroferty.";
}

<tr>
<td style="padding:20px 24px;font-size:14px;">

<table width="100%" cellpadding="6" cellspacing="0" style="font-size:14px;">
<tr>
<td style="color:#64748b;width:40%;">Kupujący</td>
<td style="font-weight:500;">@Model.BuyerNickname</td>
</tr>
<tr>
<td style="color:#64748b;">Sprzedający</td>
<td style="font-weight:500;">@Model.SellerNickname</td>
</tr>
<tr>
<td style="color:#64748b;">Data utworzenia</td>
<td>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
</tr>
</table>

</td>
</tr>

<tr>
<td style="padding:0 24px;">
<hr style="border:none;border-top:1px solid #e2e8f0;">
</td>
</tr>

<tr>
<td style="padding:20px 24px;">

<div style="font-size:14px;font-weight:600;margin-bottom:10px;">
Szczegóły wymiany
</div>

<div style="margin-bottom:12px;font-size:13px;font-weight:500;">@Model.BuyerNickname przekazuje:</div>
<table width="100%" cellpadding="8" cellspacing="0" style="border:1px solid #e2e8f0;border-radius:8px;font-size:13px;margin-bottom:12px;">
<tr style="background-color:#f8fafc;color:#64748b;">
<th align="left">Item</th>
<th align="left">Ilość</th>
</tr>
@foreach (var item in Model.BuyerItems)
{
<tr>
<td>@item.Name</td>
<td>@item.Amount</td>
</tr>
}
</table>

<div style="margin-bottom:12px;font-size:13px;font-weight:500;">@Model.SellerNickname przekazuje:</div>
<table width="100%" cellpadding="8" cellspacing="0" style="border:1px solid #e2e8f0;border-radius:8px;font-size:13px;">
<tr style="background-color:#f8fafc;color:#64748b;">
<th align="left">Item</th>
<th align="left">Ilość</th>
</tr>
@foreach (var item in Model.SellerItems)
{
<tr>
<td>@item.Name</td>
<td>@item.Amount</td>
</tr>
}
</table>

</td>
</tr>

<tr>
<td style="padding:0 24px;">
<hr style="border:none;border-top:1px solid #e2e8f0;">
</td>
</tr>

<tr>
<td style="padding:20px 24px;">

<div style="font-size:14px;font-weight:600;margin-bottom:10px;">
Co dalej?
</div>

<p style="margin:0 0 10px 0;font-size:13px;line-height:1.6;color:#475569;">
Teraz nasz pracownik, który zajmie się Państwa wymianą, skontaktuje się z Państwem na platformie w indywidualnie utworzonym chacie.
</p>

<p style="margin:0 0 10px 0;font-size:13px;line-height:1.6;color:#475569;">
W trakcie rozmowy otrzymają Państwo instrukcje dotyczące przekazania przedmiotów oraz kolejnych etapów realizacji trade'a.
</p>

<p style="margin:0;font-size:13px;line-height:1.6;color:#475569;">
Prosimy o nieprzekazywanie itemów poza systemem oraz o bieżące monitorowanie wiadomości.
</p>

</td>
</tr>

<tr>
<td style="padding:0 24px;">
<hr style="border:none;border-top:1px solid #e2e8f0;">
</td>
</tr>

<tr>
<td style="padding:20px 24px;font-size:14px;">

<div style="font-weight:600;margin-bottom:8px;">
Podsumowanie
</div>

<table width="100%" cellpadding="6" cellspacing="0" style="font-size:14px;">
<tr>
<td style="color:#64748b;width:40%;">Koszt tokenów</td>
<td style="font-weight:500;">@Model.TokensCost</td>
</tr>
<tr>
<td style="color:#64748b;">Status</td>
<td style="font-weight:500;">Oczekuje na kontakt pracownika</td>
</tr>
</table>

<div style="margin-top:20px;text-align:center;">
<a href="@Model.TradeUrl" style="display:inline-block;background-color:#0f172a;color:#ffffff;padding:10px 18px;border-radius:6px;text-decoration:none;font-size:13px;font-weight:500;">
Przejdź do trade'a
</a>
</div>

</td>
</tr>
